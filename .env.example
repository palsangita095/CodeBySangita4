# ============================================================
# Sangita Portfolio - Environment Variables
# ------------------------------------------------------------
# Copy this file to `.env` and fill in your own keys.
#   cp .env.example .env
#
# NEVER commit the real `.env` file (it is git-ignored).
# ============================================================

# --- EmailJS (contact form) ---
# Create a free account at https://www.emailjs.com/
# 1) Email Services  -> Add New Service   -> copy the Service ID
# 2) Email Templates -> Create New Template (see template variables below)
#                       -> copy the Template ID
# 3) Account -> General -> copy the Public Key
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Template variables to use inside your EmailJS template:
#   {{from_email}}  - sender's email address
#   {{subject}}     - message subject
#   {{message}}     - message body
#   {{to_email}}    - your inbox address (sangitapal131@gmail.com)
